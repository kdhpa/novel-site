# Database
# The Vercel Web Runtime should use the provider's serverless-compatible pooler URL.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require"
# Migration-only connection for local Prisma CLI and GitHub Actions. Do not add
# this value to the Vercel Runtime unless a separate administrative task needs it.
DIRECT_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require"
# Playwright refuses to start without an explicit test DB. Use a local DB whose
# name contains test, e2e, or ci. Remote test DBs additionally require
# E2E_ALLOW_REMOTE_DATABASE=true.
E2E_DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:5432/novelverse_e2e?schema=public"
E2E_ALLOW_REMOTE_DATABASE="false"
# Local/self-hosted default. Start the Vercel Web project at 2 to limit connection fan-out.
DB_POOL_MAX="10"
CONTENT_VIEW_RETENTION_DAYS="90"
IMAGE_JOB_RETENTION_DAYS="30"
# Resolved reports and administrator audit records. Open reports are retained
# until they are reviewed. Allowed range: 30-3650 days.
MODERATION_RECORD_RETENTION_DAYS="365"
# Must match the actual snapshot/database backup lifecycle configured at the provider.
BACKUP_RETENTION_DAYS="30"
# 32+ random characters. Vercel Cron sends this value as a Bearer token to the
# daily maintenance route configured in apps/web/vercel.json.
CRON_SECRET=""
MAX_NOVELS_PER_USER="50"
MAX_CHAPTERS_PER_NOVEL="1000"
MAX_CHARACTERS_PER_NOVEL="100"

# Authentication
NEXTAUTH_SECRET="replace-with-at-least-32-random-characters"
# Set to the canonical Web production origin in the Vercel Web project.
NEXTAUTH_URL="http://localhost:3000"
AUTH_SECRET="replace-with-the-same-secret-for-ops"
# Set to the canonical Ops origin in the separate Vercel Ops project.
AUTH_URL="http://localhost:3002"
AUTH_TRUST_HOST="false"
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
# Keep false in production when Google SSO is available. Set true only when
# password login is required; the account must still have the ADMIN role.
OPS_ALLOW_PASSWORD_LOGIN="false"
# Optional Ops Google Workspace hosted-domain claim.
OPS_GOOGLE_HOSTED_DOMAIN=""
RESEND_API_KEY=""
EMAIL_FROM="NovelVerse <auth@example.com>"
AUTH_EMAIL_TIMEOUT_MS="10000"
# One-shot operator input for `npm run bootstrap:admin`. Remove it immediately after use.
BOOTSTRAP_ADMIN_EMAIL=""

# Client IP trust for rate limits and anonymous view deduplication.
# Allowed: none, vercel, cloudflare, generic. Set vercel only in the Vercel Web
# projects; local development should keep none.
TRUSTED_PROXY_PROVIDER="none"
# Used only by generic. Count trusted proxies from the app back toward the client.
# The selected client address is read from X-Forwarded-For from the right.
TRUSTED_PROXY_HOPS="1"

# Persistent image storage
NEXT_PUBLIC_SUPABASE_URL=""
NEXT_PUBLIC_SUPABASE_ANON_KEY=""
# Preferred server-only Supabase key (sb_secret_...). Never expose it to the browser.
SUPABASE_SECRET_KEY=""
# Legacy server-only compatibility key.
SUPABASE_SERVICE_ROLE_KEY=""
# Optional official Supabase Storage S3 credentials. Set all four together.
# NEXT_PUBLIC_SUPABASE_URL is also required to build and validate public bucket URLs.
# S3 access keys bypass Storage RLS and must remain server-only. The four application
# buckets must already exist as public buckets for generated URLs to be readable.
SUPABASE_S3_ENDPOINT=""
SUPABASE_S3_REGION=""
SUPABASE_S3_ACCESS_KEY_ID=""
SUPABASE_S3_SECRET_ACCESS_KEY=""
# Extra exact hostnames for a trusted R2/CDN public image origin (comma-separated).
NEXT_PUBLIC_IMAGE_HOSTS=""
# Production server uploads require a secret/service-role key or all four S3 values.
# Keep bucket writes closed to anon users. Vercel production must set this to true
# and configure Supabase. Vercel's local
# filesystem is ephemeral and LOCAL_UPLOAD_ROOT is intentionally not accepted.
REQUIRE_PERSISTENT_STORAGE="false"
# Self-hosted persistent fallback. Files are served through the validated /uploads route.
LOCAL_UPLOAD_ROOT=""
# Emergency opt-out only. Never enable on Vercel or another disposable filesystem.
ALLOW_EPHEMERAL_STORAGE="false"

# Comma-separated additions to the built-in HTTPS image host allowlist.
REMOTE_IMAGE_ALLOWED_HOSTS=""
# Node/Vercel emergency override only. Keep false in production and prefer an exact allowlist.
REMOTE_IMAGE_ALLOW_ANY_PUBLIC_HOST="false"

# AI providers
REPLICATE_API_TOKEN=""
# Leave both model overrides empty to use the warm official
# black-forest-labs/flux-schnell backend. Set a legacy community-model version
# hash or owner/model:version only when an explicit fallback is required.
REPLICATE_ANIME_MODEL_VERSION=""
# Backward-compatible alias used only when a version is not set.
REPLICATE_ANIME_MODEL=""
# Optional explicit HTTPS override. Otherwise NEXT_PUBLIC_APP_URL is used to
# build /api/webhooks/replicate in production.
REPLICATE_WEBHOOK_URL=""
# Optional cached whsec_ signing secret. When empty, the server fetches it from
# Replicate with REPLICATE_API_TOKEN and caches it in memory.
REPLICATE_WEBHOOK_SIGNING_SECRET=""
REPLICATE_IMAGE_TIMEOUT_SECONDS="120"
REPLICATE_HTTP_TIMEOUT_MS="30000"
REPLICATE_IMAGE_POLL_INTERVAL_MS="2000"
# Legacy community-model settings. The official default uses its supported
# four-step FLUX schema and ignores these values.
REPLICATE_IMAGE_STEPS="20"
REPLICATE_IMAGE_GUIDANCE_SCALE="7"
GOOGLE_GEMINI_API_KEY=""
# Gemini runtime enable/disable is managed in Ops. The API key remains server-only.
# DB-backed rolling daily circuit breaker shared by paid AI requests.
AI_GLOBAL_DAILY_LIMIT="1000"

# Public origins used for metadata, links and cross-app navigation. In Vercel,
# configure canonical Production domains here rather than temporary Preview URLs.
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_WEB_URL="http://localhost:3000"
# Local development only. Do not configure NEXT_PUBLIC_OPS_URL in Vercel Web.
NEXT_PUBLIC_OPS_URL="http://localhost:3002"
# Required in production: monitored email address or HTTPS request page.
NEXT_PUBLIC_PRIVACY_CONTACT=""
