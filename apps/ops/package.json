{
  "name": "@novelverse/ops",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p 3002",
    "prebuild": "npm --prefix ../.. run prisma:generate",
    "build": "next build",
    "cf:build": "cross-env CLOUDFLARE_WORKERS_BUILD=true opennextjs-cloudflare build",
    "cf:preview": "opennextjs-cloudflare preview",
    "cf:deploy": "opennextjs-cloudflare deploy",
    "cf:typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts",
    "start": "next start -p 3002",
    "lint": "eslint ."
  },
  "dependencies": {
    "@novelverse/auth": "0.1.0",
    "@novelverse/db": "0.1.0",
    "@novelverse/shared": "0.1.0",
    "lucide-react": "^0.563.0",
    "next": "^16.2.10",
    "next-auth": "^5.0.0-beta.31",
    "react": "19.2.3",
    "react-dom": "19.2.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.1.18",
    "@types/node": "^20.19.32",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "eslint": "^9.39.2",
    "eslint-config-next": "^16.2.10",
    "tailwindcss": "^4.1.18",
    "typescript": "^5.9.3"
  }
}
