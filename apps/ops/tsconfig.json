{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "baseUrl": ".",
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": ["./src/*"],
      "@novelverse/db": ["../../packages/db/src/index.ts"],
      "@novelverse/db/*": ["../../packages/db/src/*"],
      "@novelverse/auth": ["../../packages/auth/src/index.ts"],
      "@novelverse/auth/*": ["../../packages/auth/src/*"],
      "@novelverse/shared": ["../../packages/shared/src/index.ts"],
      "@novelverse/shared/*": ["../../packages/shared/src/*"]
    }
  },
  "include": [
    "next-env.d.ts",
    "src/**/*.ts",
    "src/**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts",
    "**/*.mts"
  ],
  "exclude": ["node_modules"]
}
