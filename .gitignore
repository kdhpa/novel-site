# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
node_modules/
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage
/playwright-report/
/test-results/

# next.js
/.next/
apps/*/.next/
apps/*/.open-next/
apps/*/.wrangler/
apps/*/cloudflare-env.d.ts
/out/

# production
/build
apps/web/public/uploads/
/public/uploads/

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example
**/.dev.vars*
!**/.dev.vars.example

# local agent and development process artifacts
/.claude/settings.local.json
/.codex/
/.mcp.json
/Logs/
/nul

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

**/src/generated/prisma
**/src/generated/prisma-cloudflare
