{
  "name": "novelverse-workspace",
  "version": "0.1.0",
  "private": true,
  "packageManager": "npm@11.4.2",
  "engines": {
    "node": ">=22 <25",
    "npm": ">=10"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "overrides": {
    "@hono/node-server": "1.19.14",
    "postcss": "8.5.19"
  },
  "scripts": {
    "dev": "npm run dev -w @novelverse/web",
    "dev:web": "npm run dev -w @novelverse/web",
    "dev:ops": "npm run dev -w @novelverse/ops",
    "build": "npm run build:web && npm run build:ops",
    "build:web": "npm run build -w @novelverse/web",
    "build:ops": "npm run build -w @novelverse/ops",
    "start": "npm run start -w @novelverse/web",
    "start:web": "npm run start -w @novelverse/web",
    "start:ops": "npm run start -w @novelverse/ops",
    "lint": "eslint apps packages e2e playwright.config.ts vitest.config.ts",
    "typecheck": "npm run typecheck:packages && npm run typecheck:web && npm run typecheck:ops && npm run typecheck:e2e",
    "typecheck:packages": "tsc -p tsconfig.json --noEmit",
    "typecheck:web": "tsc -p apps/web/tsconfig.json --noEmit",
    "typecheck:ops": "tsc -p apps/ops/tsconfig.json --noEmit",
    "typecheck:e2e": "tsc -p e2e/tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "check": "npm run prisma:validate && npm run lint && npm run typecheck && npm test && npm run build",
    "prisma:generate": "prisma generate",
    "prisma:validate": "prisma validate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:deploy": "prisma migrate deploy",
    "bootstrap:admin": "node --env-file-if-exists=.env.local --env-file-if-exists=.env packages/db/scripts/bootstrap-admin.mjs"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "@types/node": "^20",
    "@types/pg": "^8.16.0",
    "dotenv": "^17.4.2",
    "eslint": "^9",
    "eslint-config-next": "^16.2.10",
    "pg": "^8.17.2",
    "prisma": "^7.8.0",
    "typescript": "^5",
    "vitest": "^4.1.10"
  }
}
